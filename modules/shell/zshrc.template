# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Powerlevel10k is the prompt managed by the zsh module.
ZSH_THEME="powerlevel10k/powerlevel10k"

# Auto-update oh-my-zsh daily without prompting
export UPDATE_ZSH_DAYS=1
zstyle ':omz:update' mode auto

# Prevent oh-my-zsh from mangling pasted URLs
DISABLE_MAGIC_FUNCTIONS=true

# Let the terminal multiplexer handle the terminal title.
DISABLE_AUTO_TITLE="true"

# Plugins: git is built into oh-my-zsh; zsh-autosuggestions and
# zsh-syntax-highlighting are git-cloned custom plugins.
plugins=(
	git
	zsh-autosuggestions
	zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# --- Shell integrations ---

eval "$(direnv hook zsh)"
