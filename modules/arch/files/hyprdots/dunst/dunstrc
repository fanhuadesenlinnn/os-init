# Dunst 通知配置：控制通知弹窗位置、尺寸、颜色、图标和点击行为。
# 修改后可执行 `pkill dunst; dunst &` 或重新登录让配置生效。
[global]
    monitor = 0
    follow = none
    width = 340
    height = 150
    origin = top-center
    alignment = "left"
    vertical_alignment = "center"
    ellipsize = "middle"
    offset = "15x15"
    padding = 15
    horizontal_padding = 15
    text_icon_padding = 15
    icon_position = "left"
    min_icon_size = 48
    max_icon_size = 48
    progress_bar = true
    progress_bar_height = 7
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_corner_radius = 2
    progress_bar_corners = 0
    progress_bar_max_width = 300
    separator_height = 2
    frame_width = 2
    frame_color = "#6272A4"
    separator_color = "#44475A"
    corner_radius = 6
    transparency = 0
    gap_size = 8
    line_height = 2
    notification_limit = 0
    idle_threshold = 120
    history_length = 20
    show_age_threshold = 60
    markup = "full"
    font = "Monaco 11"
    format = "<b>%s</b>\n%b"
    word_wrap = "yes"
    sort = "yes"
    shrink = "no"
    indicate_hidden = "yes"
    sticky_history = "no"
    ignore_newline = "no"
    show_indicators = "no"
    stack_duplicates = true
    always_run_script = true
    hide_duplicate_count = false
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false
    mouse_left_click = "do_action"
    mouse_middle_click = "close_all"
    mouse_right_click = "close_current"
[experimental]
    per_monitor_dpi = false


[urgency_low]
    background = "#1C1C1C"
    foreground = "#C5C8C6"
    highlight = "#81A2BE"
    timeout = 4

[urgency_normal]
    background = "#1C1C1C"
    foreground = "#F8F8F2"
    highlight = "#81A2BE"
    timeout = 6

[urgency_critical]
    background = "#282A36"
    foreground = "#F8F8F2"
    highlight = "#FF5555"
    timeout = 0
