#!/usr/bin/env bash
# ArchDevKit 默认配置
# 修改这里可以改变交互式和参数式安装的默认行为。

# =========================
# 全局行为
# =========================
ASSUME_YES=0
DRY_RUN=0
ARCHDEVKIT_DEFAULT_PROFILE="dev"
ARCHDEVKIT_USE_STATE=1
ARCHDEVKIT_STATE_DIR="${HOME}/.local/state/archdevkit"
ARCHDEVKIT_LOAD_CONFIG_FILE="${ARCHDEVKIT_LOAD_CONFIG_FILE:-1}"
ARCHDEVKIT_CONFIG_FILE="${ARCHDEVKIT_CONFIG_FILE:-${HOME}/.config/archdevkit/config.env}"
ARCHDEVKIT_JSON_SCHEMA_VERSION="${ARCHDEVKIT_JSON_SCHEMA_VERSION:-1}"

# =========================
# 中国大陆网络默认配置
# =========================
ENABLE_CHINA_MIRROR=1
ENABLE_GITHUB_PROXY=1
GITHUB_PROXY="https://hubproxy.babadafafafafa.cn/"

NPM_REGISTRY="https://registry.npmmirror.com"
PIP_INDEX_URL="https://pypi.tuna.tsinghua.edu.cn/simple"
PIP_TRUSTED_HOST="pypi.tuna.tsinghua.edu.cn"
NODE_MIRROR_URL="https://npmmirror.com/mirrors/node/"
GO_DOWNLOAD_MIRROR="https://mirrors.aliyun.com/golang"
GO_REPO_URL="https://github.com/golang/go"
PYTHON_BUILD_MIRROR_URL="https://registry.npmmirror.com/-/binary/python/"
PYENV_REPO_URL="https://github.com/pyenv/pyenv.git"
ENABLE_MISE_GITHUB_URL_REPLACEMENT=1 # 仅用于临时 git insteadOf，不启用 broad MISE_URL_REPLACEMENTS

# =========================
# DNS：systemd-resolved 系统解析基线
# =========================
ENABLE_DNS=1
DNS_SERVERS=(223.5.5.5 223.6.6.6 119.29.29.29 114.114.114.114)
DNS_FALLBACK_SERVERS=(180.76.76.76 114.114.115.115)
DNS_FOREIGN_FALLBACK_SERVERS=(1.1.1.1 8.8.8.8)
DNS_DNSSEC="no"
DNS_OVER_TLS="no"
DNS_CACHE="yes"
DNS_LLMNR="no"
DNS_MULTICAST_DNS="no"
DNS_CONFIGURE_NETWORKMANAGER=1
DNS_LINK_RESOLV_CONF=1
DNS_RESTART_NETWORKMANAGER=0

# =========================
# archlinuxcn
# =========================
INSTALL_ARCHLINUXCN=1
# 中国大陆默认使用 USTC archlinuxcn 镜像，减少首次安装时的解析和跨境网络波动。
ARCHLINUXCN_SERVER='https://mirrors.ustc.edu.cn/archlinuxcn/$arch'
INSTALL_ARCHLINUXCN_MIRRORLIST=1

# =========================
# Runtime：pacman 安装系统级开发语言，mise 只作为后续多版本管理器
# =========================
RUNTIME_MANAGER="mise"
NODE_VERSION="22"
NPM_VERSION="11"
PYTHON_VERSION="3.13"
GO_VERSION="1.23"
ENABLE_COREPACK=1

# =========================
# Ops Toolkit：可更新的运维脚本仓库和稳定命令入口
# =========================
ENABLE_OPS_TOOLKIT=1 # 1=随 dev/workstation 安装，0=dev/workstation 跳过；直接执行 ops-toolkit 命令不受此项限制
OPS_TOOLKIT_REPO="https://github.com/fanhuadesenlinnn/ops-toolkit.git"
OPS_TOOLKIT_BRANCH=""
OPS_TOOLKIT_DIR="${HOME}/.local/share/ops-toolkit"
OPS_TOOLKIT_BIN_DIR="${HOME}/.local/bin"
OPS_TOOLKIT_COMMAND="ops"

# =========================
# Neovim
# =========================
NVIM_REPO="https://github.com/fanhuadesenlinnn/nvim.git"
NVIM_BRANCH=""
NVIM_CONFIG_DIR="${HOME}/.config/nvim"
SYNC_NVIM_PLUGINS=1

# =========================
# Zsh / Oh My Zsh / Powerlevel10k
# =========================
INSTALL_OH_MY_ZSH=1
INSTALL_POWERLEVEL10K=1
INSTALL_P10K_CONFIG=1
SET_ZSH_AS_DEFAULT=1

OH_MY_ZSH_REPO="https://github.com/ohmyzsh/ohmyzsh.git"
ZSH_AUTOSUGGESTIONS_REPO="https://github.com/zsh-users/zsh-autosuggestions.git"
ZSH_SYNTAX_HIGHLIGHTING_REPO="https://github.com/zsh-users/zsh-syntax-highlighting.git"
POWERLEVEL10K_REPO="https://github.com/romkatv/powerlevel10k.git"

ZSH_THEME_NAME="powerlevel10k/powerlevel10k"
ZSH_PLUGINS="git zsh-autosuggestions zsh-syntax-highlighting fzf docker kubectl"
P10K_CONFIG_SOURCE="${SCRIPT_DIR}/files/p10k.zsh"

# =========================
# 字体
# =========================
INSTALL_CN_FONTS=1
INSTALL_NERD_FONTS=1
INSTALL_MONACO_FONT=1
MONACO_AS_SYSTEM_FONT=1
SYSTEM_FONT_FAMILY="Monaco"
SYSTEM_MONOSPACE_FONT_FAMILY="Monaco"
SYSTEM_CJK_FONT_FAMILY="Noto Sans CJK SC"
SYSTEM_EMOJI_FONT_FAMILY="Noto Color Emoji"
# Monaco 通过 archlinuxcn 源安装，避免维护本地字体文件或第三方下载 URL。
MONACO_FONT_PACKAGE="ttf-monaco"

# =========================
# Docker
# =========================
ENABLE_DOCKER_SERVICE=1
ADD_USER_TO_DOCKER_GROUP=1
CONFIGURE_DOCKER_MIRRORS=1
DOCKER_MIRRORS=(
  "https://hubproxy.babadafafafafa.cn"
  "https://docker.1panel.live"
)

# =========================
# Hyprland
# =========================
ENABLE_SDDM=1
ENABLE_BLUETOOTH=1
ENABLE_FCITX5=1
INPUT_METHOD_ENGINE="rime"
RIME_SCHEMA="luna_pinyin_simp"
INSTALL_RIME_CONFIG=1
RIME_CONFIG_REPO="https://github.com/fanhuadesenlinnn/rime-config.git"
RIME_CONFIG_BRANCH=""
RIME_CONFIG_DIR="${HOME}/.local/share/fcitx5/rime"
GPU_TYPE="auto" # auto / intel / amd / nvidia / vmware / virtio / qxl / virtualbox / none
VMWARE_HYPRLAND_MONITOR_MODE="1920x1080@60"
# VMware SVGA3D can pass EGL detection but still fail native Wayland GL clients.
# Default to llvmpipe so Alacritty/Neovide work with or without VMware 3D acceleration.
VMWARE_FORCE_SOFTWARE_RENDERER=1
VM_HYPRLAND_MONITOR_MODE="1920x1080@60"
VM_HYPRLAND_DYNAMIC_RESIZE=1
VM_HYPRLAND_LOW_LATENCY=1
HYPRLAND_CONFIG_MODE="hyprdots" # hyprdots / template / skip
HYPRDOTS_SOURCE_DIR="${SCRIPT_DIR}/files/hyprdots"
HYPRDOTS_SOURCE_COMMIT="0158219"
HYPRDOTS_LOCAL_BIN_DIR="${HOME}/.local/bin"
HYPRDOTS_WALLPAPER_DIR="${HOME}/Pictures/Wallpaper"
INSTALL_HYPRDOTS_OBSIDIAN=0
HYPRDOTS_CONFIG_MODULES=(
  hypr
  waybar
  rofi
  dunst
  yazi
  btop
  alacritty
  gtk-3.0
  gtk-4.0
)

TERMINAL_APP="${HOME}/.local/bin/archdevkit-terminal"
APP_LAUNCHER="rofi"
FILE_MANAGER="yazi"
BROWSER_PACKAGE="google-chrome"
BROWSER_APP="google-chrome-stable"

# =========================
# Proxy：代理核心和面板（可选）
# =========================
ENABLE_PROXY=1 # 1=随 dev/workstation 安装，0=dev/workstation 跳过；直接执行 proxy 命令不受此项限制
PROXY_CORE="mihomo" # mihomo / sing-box
PROXY_AUTO_ENABLE_SERVICE=1 # 1=安装后启用并启动服务，0=只安装和生成配置

MIHOMO_PACKAGE="mihomo"
MIHOMO_SERVICE_NAME="mihomo.service"
MIHOMO_CONFIG_DIR="/etc/mihomo"
MIHOMO_CONFIG_FILE="${MIHOMO_CONFIG_DIR}/config.yaml"
MIHOMO_CONFIG_SOURCE="${SCRIPT_DIR}/files/mihomo/config.yaml.tpl" # 本地 config.yaml/.tpl 或 URL；为空则渲染默认模板
# Mihomo 规则源和 GEO 数据源保持原始 URL，不通过 GITHUB_PROXY 生成代理前缀。
MIHOMO_MIXED_PORT=7890
MIHOMO_ALLOW_LAN=0
MIHOMO_BIND_ADDRESS="0.0.0.0"
MIHOMO_CONTROLLER_HOST="0.0.0.0"
MIHOMO_CONTROLLER_PORT=9090
MIHOMO_DNS_LISTEN="0.0.0.0:1053"
MIHOMO_SECRET=""
MIHOMO_STATE_DIR="/var/lib/mihomo"
MIHOMO_EXTERNAL_UI_DIR="${MIHOMO_STATE_DIR}/ui"

ENABLE_METACUBEXD=1 # 1=安装 MetaCubeXD 面板，0=不安装面板
METACUBEXD_PACKAGE="metacubexd-bin"
METACUBEXD_WEB_ROOT="/usr/share/metacubexd"

SING_BOX_PACKAGE="sing-box"
SING_BOX_CONFIG_DIR="${HOME}/.config/sing-box"
SING_BOX_CONFIG_FILE="${SING_BOX_CONFIG_DIR}/config.json"
SING_BOX_CONFIG_SOURCE="${SCRIPT_DIR}/files/sing-box/config.json.tpl" # 本地 config.json/.tpl 或 URL；为空则渲染默认模板
SING_BOX_MIXED_PORT=7890
