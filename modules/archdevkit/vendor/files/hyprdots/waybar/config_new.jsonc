// Waybar 新版状态栏配置：定义模块顺序、点击动作和刷新频率。
// 左侧偏系统监控，中间时钟，右侧壁纸/透明度/亮度/音量/网络/电池/托盘。
{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 32,
  "margin-bottom": 0,
  "modules-left": [
    "hyprland/workspaces",
    "custom/seperator",
    "cpu",
    "custom/seperator",
    "memory",
    "custom/seperator",
    "network#speed"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "hyprland/submap",
    "custom/wallpaper",
    "custom/seperator",
    "custom/transparency",
    "custom/seperator",
    "backlight",
    "custom/seperator",
    "wireplumber",
    "custom/seperator",
    "network",
    "custom/seperator",
    "battery",
    "tray"
  ],
  // Hyprland 子模式提示，点击可退出当前 submap。
  "hyprland/submap": {
    "format": "SUB {}",
    "max-length": 20,
    "tooltip": false,
    "on-click": "hyprctl dispatch submap reset"
  },
  "custom/seperator": {
    "format": "<span>|</span>",
    "tooltip": false
  },
  "custom/transparency": {
    "format": "TRAN",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/toggle-trans.sh"
  },
  "backlight": {
    "scroll-step": 5,
    "format": "BL {percent}%",
    "tooltip": true,
    "tooltip-format": "Brightness {percent}%"
  },
  "wireplumber": {
    "max-volume": 200,
    "scroll-step": 5,
    "format": "VOL {volume}%",
    "format-muted": "MUTE",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click": "pamixer -t",
    "tooltip": true,
    "tooltip-format": "{volume}% | {desc}"
  },
  // 网络模块：左键打开 Rofi Wi-Fi 菜单，右键用终端打开 nmtui。
  "network": {
    "format-wifi": "WIFI {essid}",
    "format-ethernet": "ETH",
    "format-disconnected": "NET down",
    "interval": 5,
    "tooltip-format-wifi": "Down {bandwidthDownBytes} | Up {bandwidthUpBytes} | {essid}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.config/rofi/wifi/wifi.sh",
    "on-click-right": "~/.local/bin/archdevkit-terminal -e nmtui"
  },
  "network#speed": {
    "interval": 1,
    "format": "{ifname}",
    "format-wifi": "DOWN {bandwidthDownBytes}  UP {bandwidthUpBytes}",
    "format-ethernet": "DOWN {bandwidthDownBytes}  UP {bandwidthUpBytes}",
    "format-disconnected": "NET down",
    "tooltip-format": "{ipaddr}",
    "tooltip-format-wifi": "{essid} {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 28,
    "min-length": 18
  },
  // CPU/内存模块：点击进入 btop 任务管理器。
  "cpu": {
    "interval": 1,
    "format": "<span color='#8aadf4'>CPU</span> {usage}%",
    "on-click": "~/.local/bin/archdevkit-terminal -e btop"
  },
  "memory": {
    "interval": 1,
    "format": "<span color='#8aadf4'>MEM</span> {percentage}%",
    "on-click": "~/.local/bin/archdevkit-terminal -e btop",
    "tooltip-format": "{used}/{total} GiB"
  },
  "custom/wallpaper": {
    "format": "WALL",
    "on-click": "~/.config/waybar/scripts/change-wallpaper.sh",
    "tooltip": false,
    "on-click-right": "~/.local/bin/archdevkit-terminal -e ~/.config/waybar/scripts/select-wallpaper.sh"
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {},
    "persistent-workspaces": {
      "*": 4
    },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },
  "clock": {
    "format": "{:%H:%M / %h %d}",
    "tooltip": true,
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "battery": {
    "format": "BAT {capacity}%",
    "format-plugged": "AC {capacity}%",
    "format-full": "BAT full",
    "format-alt": "BAT {time}",
    "tooltip-format-discharging": "{power:>1.0f}W -> {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W -> {capacity}%",
    "interval": 5,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    }
  },
  "tray": {
    "icon-size": 12,
    "spacing": 12
  }
}
