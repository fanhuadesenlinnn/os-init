OS_INIT_LANG=zh_CN
OS_INIT_REGION=cn
OS_INIT_CONFIG_PROMPT=1
OS_INIT_OFFLINE=0
OS_INIT_FILES_DIR=/opt/os-init/packages
OS_INIT_SCRIPT_TIMEOUT=45m
OS_INIT_TERMINAL_STYLE=auto
OS_INIT_TERMINAL_ENABLE_ALIASES=1
OS_INIT_TERMINAL_BAT_THEME="Catppuccin Mocha"

DOWNLOAD_RETRY=3
DOWNLOAD_TIMEOUT=30
GITHUB_PROXY=

HOMEBREW_INSTALL_URL=https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
HOMEBREW_API_DOMAIN=
HOMEBREW_BOTTLE_DOMAIN=
HOMEBREW_ARTIFACT_DOMAIN=
HOMEBREW_BREW_GIT_REMOTE=
HOMEBREW_CORE_GIT_REMOTE=
HOMEBREW_PIP_INDEX_URL=

OH_MY_ZSH_REPO=https://github.com/ohmyzsh/ohmyzsh.git
STARSHIP_INSTALL_URL=https://starship.rs/install.sh
DIRENV_PACKAGE=direnv
ZSH_AUTOSUGGESTIONS_REPO=https://github.com/zsh-users/zsh-autosuggestions.git
ZSH_SYNTAX_HIGHLIGHTING_REPO=https://github.com/zsh-users/zsh-syntax-highlighting.git
NVM_VERSION=
NVM_INSTALL_BASE=https://raw.githubusercontent.com/nvm-sh/nvm
NVM_INSTALL_URL=
FNM_INSTALL_URL=https://fnm.vercel.app/install

DOCKER_DOWNLOAD_BASE=https://download.docker.com
DOCKER_CHANNEL=stable
DOCKER_VERSION=
DOCKER_TGZ_URL=
DOCKER_COMPOSE_VERSION=
DOCKER_COMPOSE_DOWNLOAD_BASE=https://github.com/docker/compose/releases/download
DOCKER_COMPOSE_DOWNLOAD_URL=
DOCKER_REGISTRY_MIRRORS=
DOCKER_INSECURE_REGISTRIES=
DOCKER_DATA_ROOT=

MIHOMO_PACKAGE=mihomo
MIHOMO_VERSION=
MIHOMO_DOWNLOAD_BASE=
MIHOMO_DOWNLOAD_URL=
MIHOMO_BINARY_SOURCE=
MIHOMO_SERVICE_NAME=mihomo.service
MIHOMO_CONFIG_DIR=/etc/mihomo
MIHOMO_CONFIG_FILE=/etc/mihomo/config.yaml
MIHOMO_CONFIG_SOURCE=
MIHOMO_MIXED_PORT=7890
MIHOMO_ALLOW_LAN=0
MIHOMO_BIND_ADDRESS=127.0.0.1
MIHOMO_CONTROLLER_HOST=127.0.0.1
MIHOMO_CONTROLLER_PORT=9090
MIHOMO_DNS_LISTEN=127.0.0.1:1053
MIHOMO_SECRET=
MIHOMO_STATE_DIR=/var/lib/mihomo
MIHOMO_EXTERNAL_UI_DIR=/var/lib/mihomo/ui
MIHOMO_AUTO_ENABLE_SERVICE=1
ENABLE_METACUBEXD=1
METACUBEXD_SOURCE=
METACUBEXD_REPO=https://github.com/metacubex/metacubexd.git

GO_VERSION=
GO_DOWNLOAD_BASE=https://go.dev/dl
GO_VERSION_URL=https://go.dev/VERSION?m=text
GO_DOWNLOAD_URL=

NVIM_DOWNLOAD_BASE=https://github.com/neovim/neovim/releases/latest/download
NVIM_DOWNLOAD_URL=
LAZYGIT_VERSION=
LAZYGIT_DOWNLOAD_BASE=https://github.com/jesseduffield/lazygit/releases/download
LAZYGIT_DOWNLOAD_URL=
LAZYVIM_STARTER_REPO=https://github.com/LazyVim/starter
YAZI_DOWNLOAD_BASE=https://github.com/sxyazi/yazi/releases/latest/download
YAZI_DOWNLOAD_URL=
