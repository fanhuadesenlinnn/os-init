# OS Init 启动配置模板
#
# 推荐复制到以下任一位置后修改：
#   /etc/os-init/config.env              # 全局配置，所有用户共用
#   ~/.config/os-init/config.env         # 当前用户配置，优先级更高
#
# 加载顺序：
#   1. 程序内置 defaults.env
#   2. /etc/os-init/config.env
#   3. ~/.config/os-init/config.env
#   4. 当前 shell 环境变量
#
# 后加载的值会覆盖先加载的值；也就是说，环境变量优先级最高。
# 配置格式为 KEY=value，也支持 export KEY=value。

# ------------------------------------------------------------
# 基础设置
# ------------------------------------------------------------

# 语言和区域。当前主要用于中文提示和中国大陆网络默认场景。
OS_INIT_LANG=zh_CN
OS_INIT_REGION=cn

# 启动时是否显示配置提示页：
#   1 = 显示；启动时提示当前使用的配置文件，未发现配置时询问是否创建
#   0 = 不显示；直接进入主菜单
OS_INIT_CONFIG_PROMPT=1

# 是否启用离线模式：
#   0 = 在线下载资源
#   1 = 不访问网络，只从 OS_INIT_FILES_DIR 查找离线包
OS_INIT_OFFLINE=0

# 离线包目录。
# 离线模式下会从这里查找 Go、Docker、Mihomo、Neovim、Yazi 等安装包。
OS_INIT_FILES_DIR=/opt/os-init/packages

# 单个模块最大执行时间。
# 支持 Go duration 格式（例如 30m、1h）或纯秒数；设置为 0 表示不限制。
OS_INIT_SCRIPT_TIMEOUT=45m

# ------------------------------------------------------------
# GitHub 代理设置
# ------------------------------------------------------------
#
# os-init 只管理 GitHub 相关 URL 代理，不提供全局 HTTP/HTTPS 代理配置。
# 如果你在启动终端里自己 export HTTP_PROXY，系统工具仍可能按自身规则继承；
# 但启动配置文件中的 OS_INIT_PROXY、HTTP_PROXY、DOWNLOAD_URL_PROXY 会被忽略。

# 下载重试次数。
DOWNLOAD_RETRY=3

# 单次下载超时时间，单位秒。
DOWNLOAD_TIMEOUT=30

# GitHub 专用代理。
# 只改写以下地址：
#   https://github.com/...
#   https://raw.githubusercontent.com/...
#   https://objects.githubusercontent.com/...
#   https://github-releases.githubusercontent.com/...
#
# 前缀模式：
#   GITHUB_PROXY=https://gh-proxy.com/
# 会变成：
#   https://gh-proxy.com/https://github.com/owner/repo/...
#
# 模板模式：
#   GITHUB_PROXY=https://proxy.example.com/?target={url}
GITHUB_PROXY=

# ------------------------------------------------------------
# Shell 生态资源
# ------------------------------------------------------------

# Homebrew 安装脚本地址。仅 macOS 模块需要。
HOMEBREW_INSTALL_URL=https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh

# Homebrew 元数据 API 地址。大陆网络访问 formulae.brew.sh 慢时可改为可信镜像。
# 示例：
#   HOMEBREW_API_DOMAIN=https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/api
HOMEBREW_API_DOMAIN=

# Homebrew bottle 二进制包下载地址。大陆网络访问 ghcr.io 慢时可改为可信镜像。
# 示例：
#   HOMEBREW_BOTTLE_DOMAIN=https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles
HOMEBREW_BOTTLE_DOMAIN=

# Homebrew artifact 下载代理前缀。会影响 formula/cask 下载，请只使用可信代理。
HOMEBREW_ARTIFACT_DOMAIN=

# Homebrew 自身和 core tap 的 Git 镜像地址。
# 注意：这些镜像拥有和 Homebrew 官方仓库接近的信任级别，请只配置可信来源。
# brew 4 以后通常优先配置 HOMEBREW_API_DOMAIN；core tap 镜像只在需要 Git tap 时有意义。
# 示例：
#   HOMEBREW_BREW_GIT_REMOTE=https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/brew.git
#   HOMEBREW_CORE_GIT_REMOTE=https://mirrors.tuna.tsinghua.edu.cn/git/homebrew/homebrew-core.git
HOMEBREW_BREW_GIT_REMOTE=
HOMEBREW_CORE_GIT_REMOTE=

# Homebrew 构建 Python 相关 formula 时使用的 PyPI 镜像。
# 只在相关 formula 需要 Python 包时有意义。
# 示例：
#   HOMEBREW_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
HOMEBREW_PIP_INDEX_URL=

# oh-my-zsh 仓库地址。可替换为镜像仓库或内网仓库。
OH_MY_ZSH_REPO=https://github.com/ohmyzsh/ohmyzsh.git

# starship 安装脚本地址。
STARSHIP_INSTALL_URL=https://starship.rs/install.sh

# direnv 包名。不同发行版如需使用自定义包名可在这里调整。
DIRENV_PACKAGE=direnv

# zsh 插件仓库地址。
ZSH_AUTOSUGGESTIONS_REPO=https://github.com/zsh-users/zsh-autosuggestions.git
ZSH_SYNTAX_HIGHLIGHTING_REPO=https://github.com/zsh-users/zsh-syntax-highlighting.git

# nvm 版本。留空时从 GitHub 查询最新版本。
NVM_VERSION=

# nvm 安装脚本基础地址。最终会拼成：
#   ${NVM_INSTALL_BASE}/${NVM_VERSION}/install.sh
NVM_INSTALL_BASE=https://raw.githubusercontent.com/nvm-sh/nvm

# nvm 完整安装脚本地址。
# 设置后优先级高于 NVM_INSTALL_BASE。
NVM_INSTALL_URL=

# fnm 安装脚本地址。
FNM_INSTALL_URL=https://fnm.vercel.app/install

# ------------------------------------------------------------
# Go 资源
# ------------------------------------------------------------

# Go 版本。留空时从 GO_VERSION_URL 查询最新版本。
# 示例：
#   GO_VERSION=go1.26.3
#   GO_VERSION=1.26.3
GO_VERSION=

# Go 最新版本查询地址。
# 默认从 go.dev 获取；国内网络不稳定时可换成镜像或内网文本地址。
GO_VERSION_URL=https://go.dev/VERSION?m=text

# Go 安装包下载基础地址。最终会拼成：
#   ${GO_DOWNLOAD_BASE}/${GO_VERSION}.linux-amd64.tar.gz
GO_DOWNLOAD_BASE=https://go.dev/dl

# Go 完整安装包地址。
# 设置后优先级高于 GO_DOWNLOAD_BASE。
GO_DOWNLOAD_URL=

# ------------------------------------------------------------
# Docker 资源和 daemon 配置
# ------------------------------------------------------------

# Docker 静态二进制版本。留空时尝试从 DOCKER_DOWNLOAD_BASE 查询最新版本。
DOCKER_VERSION=

# Docker 静态二进制下载基础地址。
DOCKER_DOWNLOAD_BASE=https://download.docker.com

# Docker 静态二进制完整下载地址。
# 设置后优先级高于 DOCKER_DOWNLOAD_BASE / DOCKER_VERSION。
DOCKER_TGZ_URL=

# Docker Compose 版本。留空时从 GitHub 查询最新版本。
DOCKER_COMPOSE_VERSION=

# Docker Compose 下载基础地址。
DOCKER_COMPOSE_DOWNLOAD_BASE=https://github.com/docker/compose/releases/download

# Docker Compose 完整下载地址。
# 设置后优先级高于 DOCKER_COMPOSE_DOWNLOAD_BASE / DOCKER_COMPOSE_VERSION。
DOCKER_COMPOSE_DOWNLOAD_URL=

# Docker 镜像加速器，多个用英文逗号分隔。
DOCKER_REGISTRY_MIRRORS=

# Docker insecure registries，多个用英文逗号分隔。
DOCKER_INSECURE_REGISTRIES=

# Docker 数据目录。留空时使用 Docker 默认目录。
DOCKER_DATA_ROOT=

# ------------------------------------------------------------
# Mihomo / MetaCubeXD
# ------------------------------------------------------------

# 是否启用 Mihomo 模块。
ENABLE_MIHOMO=1

# Mihomo 发行版包名。发行版仓库可用时优先尝试包管理器安装。
MIHOMO_PACKAGE=mihomo

# Mihomo 版本。留空时从 GitHub 查询最新版本。
MIHOMO_VERSION=

# Mihomo 下载基础地址。最终会拼成对应架构的 .gz 文件地址。
MIHOMO_DOWNLOAD_BASE=

# Mihomo 完整下载地址。设置后优先级最高。
MIHOMO_DOWNLOAD_URL=

# Mihomo 二进制来源。
# 可以是本地文件路径，也可以是远程 URL；适合内网提前放好的二进制。
MIHOMO_BINARY_SOURCE=

# Mihomo 配置来源：
# 可以是本地 config.yaml、本地 .tpl 模板，也可以是远程 URL。
# 留空时使用程序内置中文模板。
MIHOMO_CONFIG_SOURCE=

# Mihomo 基础运行配置。
MIHOMO_SERVICE_NAME=mihomo.service
MIHOMO_CONFIG_DIR=/etc/mihomo
MIHOMO_CONFIG_FILE=/etc/mihomo/config.yaml
MIHOMO_MIXED_PORT=7890
MIHOMO_ALLOW_LAN=0
MIHOMO_BIND_ADDRESS=127.0.0.1
MIHOMO_CONTROLLER_HOST=127.0.0.1
MIHOMO_CONTROLLER_PORT=9090
MIHOMO_DNS_LISTEN=127.0.0.1:1053

# 控制接口密钥。
# 如果 MIHOMO_CONTROLLER_HOST=0.0.0.0，强烈建议设置它。
MIHOMO_SECRET=

MIHOMO_STATE_DIR=/var/lib/mihomo
MIHOMO_EXTERNAL_UI_DIR=/var/lib/mihomo/ui
MIHOMO_AUTO_ENABLE_SERVICE=1

# 是否安装 MetaCubeXD 面板。
ENABLE_METACUBEXD=1

# MetaCubeXD 本地或远程压缩包来源。
# 留空时在线克隆 METACUBEXD_REPO 的 gh-pages 分支。
METACUBEXD_SOURCE=

# MetaCubeXD 仓库地址。可替换为镜像仓库或内网仓库。
METACUBEXD_REPO=https://github.com/metacubex/metacubexd.git

# ------------------------------------------------------------
# Neovim / LazyVim / lazygit / Yazi
# ------------------------------------------------------------

# Neovim 下载基础地址。
NVIM_DOWNLOAD_BASE=https://github.com/neovim/neovim/releases/latest/download

# Neovim 完整下载地址。设置后优先级高于 NVIM_DOWNLOAD_BASE。
NVIM_DOWNLOAD_URL=

# lazygit 版本。留空时从 GitHub 查询最新版本。
LAZYGIT_VERSION=

# lazygit 下载基础地址。
LAZYGIT_DOWNLOAD_BASE=https://github.com/jesseduffield/lazygit/releases/download

# lazygit 完整下载地址。设置后优先级高于 LAZYGIT_DOWNLOAD_BASE。
LAZYGIT_DOWNLOAD_URL=

# LazyVim starter 仓库地址。可替换为镜像仓库或内网仓库。
LAZYVIM_STARTER_REPO=https://github.com/LazyVim/starter

# Yazi 下载基础地址。
YAZI_DOWNLOAD_BASE=https://github.com/sxyazi/yazi/releases/latest/download

# Yazi 完整下载地址。设置后优先级高于 YAZI_DOWNLOAD_BASE。
YAZI_DOWNLOAD_URL=
